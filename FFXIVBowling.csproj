<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>NCLBowlingScore</AssemblyName>
    <Product>NCL Bowling Score</Product>
    <Version>1.0.1.0</Version>
    <Description>NCL Bowling Score — keep score at Neon Celestial Lanes.</Description>
    <PackageProjectUrl>https://github.com/NeonCelestialLanes/NCL-Bowling-Score-Keeper</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\ncl-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\LuckiestGuy-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NCLBowlingScore.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
